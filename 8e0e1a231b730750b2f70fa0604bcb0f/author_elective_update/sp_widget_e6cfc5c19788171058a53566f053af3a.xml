<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_widget">
    <sp_widget action="DELETE">
        <category>custom</category>
        <client_script><![CDATA[api.controller = function() {
    var c = this;

    c.generateBrief = function() {
        c.loading = true;
        c.data.errorMessage = '';
        c.server.get({ action: 'generateBrief' }).then(function(response) {
            c.data.brief = response.data.brief;
            c.data.errorMessage = response.data.errorMessage;
            c.data.generatedOn = response.data.generatedOn;
            c.loading = false;
        }, function() {
            c.data.errorMessage = 'The team brief could not be generated. Please try again later.';
            c.loading = false;
        });
    };
};
]]></client_script>
        <controller_as>c</controller_as>
