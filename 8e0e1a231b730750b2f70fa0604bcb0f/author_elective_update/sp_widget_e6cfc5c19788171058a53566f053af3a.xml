        <template><![CDATA[<div class="panel panel-default team-brief" ng-if="data.canUse">
  <div class="panel-heading team-brief-heading">
    <h2 class="panel-title">${Team brief}</h2>
    <span class="label label-info">${AI generated}</span>
  </div>
  <div class="panel-body">
    <p class="text-muted" ng-if="!c.data.brief && !c.loading">${Get a prioritised list of what needs your attention in your team this week.}</p>

    <button class="btn btn-primary" ng-click="c.generateBrief()" ng-disabled="c.loading">
      <span ng-if="!c.data.brief">${Generate team brief}</span>
      <span ng-if="c.data.brief">${Regenerate}</span>
    </button>
    <p class="text-muted team-brief-loading" ng-if="c.loading" aria-live="polite">${Generating your team brief}...</p>

    <div class="alert alert-danger" role="alert" ng-if="c.data.errorMessage">{{c.data.errorMessage}}</div>

    <div ng-if="c.data.brief && !c.loading">
      <div class="team-brief-text" ng-bind="c.data.brief"></div>
      <p class="text-muted small">${AI suggestions based on your team data at} {{c.data.generatedOn}}. ${Review before you act.}</p>
    </div>
  </div>
</div>
]]></template>
