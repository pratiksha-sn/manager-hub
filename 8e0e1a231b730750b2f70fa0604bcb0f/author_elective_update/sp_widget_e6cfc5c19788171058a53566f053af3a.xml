        <script><![CDATA[(function() {
    /* Manager Team Brief - runs the AI Skill Kit skill "Manager Team Brief" when the manager clicks the button.
     * The skill itself collects the data (tool GetTeamData, runs as the logged-in user) and calls the LLM. */
    var SKILL_CAPABILITY = '616cc5859748171058a53566f053affc';

    data.canUse = gs.hasRole('x_snp_manager_su_0.manager') || gs.hasRole('sn_mh.manager_hub_user');

    if (input && input.action === 'generateBrief' && data.canUse) {
        var res = sn_one_extend.OneExtendUtil.execute({
            mode: 'sync',
            executionRequests: [{ capabilityId: SKILL_CAPABILITY, payload: {} }]
        });
        var skill = res && res.capabilities && res.capabilities[SKILL_CAPABILITY];
        if (skill && skill.status === 'success' && skill.response)
            data.brief = String(skill.response);
        else
            data.errorMessage = gs.getMessage('The team brief could not be generated. Please try again later.');
        data.generatedOn = new GlideDateTime().getDisplayValue();
    }
})();
]]></script>
