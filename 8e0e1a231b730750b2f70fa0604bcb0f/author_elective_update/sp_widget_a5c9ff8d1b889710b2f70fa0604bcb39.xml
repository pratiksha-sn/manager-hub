        <name>MSR Follow-up Actions</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {
    /* MSR Follow-up Actions - Standard Ticket tab for x_snp_manager_su_0_manager_support_request.
     * Lists the follow-up actions of the request shown on the ticket page (read-only, ACLs apply). */
    var REQUEST = 'x_snp_manager_su_0_manager_support_request';
    var ACTION = 'x_snp_manager_su_0_follow_up_action';
    var TODO_PAGE = options.todo_page || 'hrm_todo';

    var requestId = options.sys_id || $sp.getParameter('sys_id');
    data.followups = [];
    if (!requestId)
        return;

    var request = new GlideRecordSecure(REQUEST);
    if (!request.get(requestId))
        return;

    var fua = new GlideRecordSecure(ACTION);
    fua.addQuery('parent', requestId);
    fua.orderBy('number');
    fua.query();
    while (fua.next()) {
        data.followups.push({
            number: fua.getValue('number'),
            action: fua.getValue('short_description'),
            assigned_to: fua.getDisplayValue('assigned_to'),
            state: fua.getDisplayValue('state'),
            active: fua.getValue('active') == '1',
            // Opens the follow-up action in the To-dos view of the portal
            link: '?id=' + TODO_PAGE + '&table=' + ACTION + '&sys_id=' + fua.getUniqueValue()
        });
    }
})();
]]></script>
