        <template><![CDATA[<div class="msr-fua">
  <div class="msr-fua-empty text-muted" ng-if="!data.followups.length">
    ${No follow-up actions yet. They are created when the request is approved.}
  </div>

  <table class="table msr-fua-table" ng-if="data.followups.length">
    <thead>
      <tr>
        <th scope="col">${Number}</th>
        <th scope="col">${Action}</th>
        <th scope="col">${Assigned to}</th>
        <th scope="col">${State}</th>
      </tr>
    </thead>
    <tbody>
      <tr ng-repeat="f in data.followups">
        <td><a ng-href="{{f.link}}">{{f.number}}</a></td>
        <td>{{f.action}}</td>
        <td>{{f.assigned_to}}</td>
        <td><span class="msr-fua-state" ng-class="{'is-closed': !f.active}">{{f.state}}</span></td>
      </tr>
    </tbody>
  </table>
</div>
]]></template>
